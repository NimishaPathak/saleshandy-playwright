{
  "name": "saleshandy-playwright",
  "version": "1.0.0",
  "description": "BDD Playwright TypeScript automation framework for Saleshandy sign-up and onboarding flows",
  "author": "Nimisha Pathak",
  "license": "MIT",
  "scripts": {
    "test": "cucumber-js",
    "test:personal": "cucumber-js --tags @personal",
    "test:business": "cucumber-js --tags @business",
    "test:clients": "cucumber-js --tags @clients",
    "test:signup": "cucumber-js --tags @signup",
    "test:onboarding": "cucumber-js --tags @onboarding",
    "test:api": "playwright test tests/api-tests --reporter=list",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "auth:setup": "ts-node -r tsconfig-paths/register src/hooks/auth.setup.ts",
    "clean": "rimraf allure-results allure-report cucumber-report dist",
    "auth:personal": "ts-node -r tsconfig-paths/register src/hooks/auth.setup.ts personal",
    "auth:business": "ts-node -r tsconfig-paths/register src/hooks/auth.setup.ts business",
    "auth:clients": "ts-node -r tsconfig-paths/register src/hooks/auth.setup.ts clients",
    "test:full": "ts-node -r tsconfig-paths/register src/hooks/auth.setup.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.14.0",
    "allure-commandline": "^2.29.0",
    "allure-playwright": "^3.0.0",
    "multiple-cucumber-html-reporter": "^3.7.0",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "tsconfig-paths": "^4.2.0"
  },
  "cucumber": {
    "require": [
      "tests/support/world.ts",
      "tests/support/hooks.ts",
      "tests/step-definitions/**/*.ts"
    ],
    "requireModule": [
      "ts-node/register",
      "tsconfig-paths/register"
    ],
    "format": [
      "progress-bar",
      "html:cucumber-report/cucumber-report.html",
      "json:cucumber-report/cucumber-report.json"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "paths": [
      "tests/features/**/*.feature"
    ],
    "publishQuiet": true
  }
}